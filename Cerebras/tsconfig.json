{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "declaration": true, "declarationMap": true, "sourceMap": true, "inlineSources": true,
    "outDir": "dist", "rootDir": "src", "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
