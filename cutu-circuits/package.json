{
  "name": "cutucircuits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-upstream.mjs",
    "dev": "concurrently -k -n runtime,workspace \"npm run dev -w @cutucircuits/runtime\" \"npm run dev -w @cutucircuits/web\"",
    "start": "tsx packages/runtime/src/main.ts",
    "build": "npm run build -w @cutucircuits/web && npm run build -w @cutucircuits/plugin",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 packages/*/tests/*.test.ts packages/editor-host/tests/*.test.mjs apps/web/tests/*.test.ts tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "demo": "node scripts/start-demo.mjs",
    "demo:check": "node scripts/start-demo.mjs --check",
    "release:source": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "3.25.76",
    "format-si-unit": "0.0.7",
    "circuit-json-to-connectivity-map": "0.0.23",
    "calculate-elbow": "0.0.12",
    "calculate-packing": "0.0.75",
    "@tscircuit/copper-pour-solver": "0.0.29",
    "@tscircuit/miniflex": "0.0.4",
    "minicssgrid": "0.0.9",
    "@tscircuit/schematic-trace-solver": "0.0.71",
    "circuit-json-to-spice": "0.0.39",
    "spicey": "0.0.14",
    "@tscircuit/infer-cable-insertion-point": "0.0.2",
    "spicets": "0.0.2",
    "@tscircuit/solver-utils": "0.0.19",
    "connectivity-map": "1.0.0",
    "graphics-debug": "0.0.95",
    "@tscircuit/mm": "0.0.8",
    "@tscircuit/krt-wasm": "0.1.6",
    "kicad-to-circuit-json": "0.0.97",
    "@tscircuit/matchpack": "0.0.23",
    "kicadts": "0.0.47",
    "schematic-symbols": "0.0.226"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "use-mouse-matrix-transform": "1.3.5",
    "@tscircuit/mm": "0.0.8",
    "@tscircuit/alphabet": "0.0.25",
    "@tscircuit/math-utils": "0.0.36",
    "@tscircuit/infgrid-ijump-astar": "0.0.35",
    "@tscircuit/checks": "0.0.138",
    "@tscircuit/ngspice-spice-engine": "0.0.18",
    "@tscircuit/internal-dynamic-import": "0.0.2",
    "@tscircuit/pcb-viewer": "1.11.374",
    "@tscircuit/image-utils": "0.0.8",
    "@tscircuit/copper-pour-solver": "0.0.29",
    "@tscircuit/core": "0.0.1348",
    "@tscircuit/simple-3d-svg": "0.0.41",
    "@tscircuit/schematic-trace-solver": "0.0.71",
    "@tscircuit/cli": "0.1.1536",
    "@tscircuit/infer-cable-insertion-point": "0.0.2",
    "@tscircuit/3d-viewer": "0.0.577",
    "@tscircuit/props": "0.0.551",
    "@tscircuit/solver-utils": "0.0.19",
    "@tscircuit/matchpack": "0.0.23",
    "@tscircuit/runframe": "0.0.2106",
    "@tscircuit/capacity-autorouter": "0.0.583",
    "@tscircuit/krt-wasm": "0.1.6",
    "@tscircuit/soup-util": "0.0.41",
    "@tscircuit/assembly-viewer": "0.0.6",
    "@tscircuit/schematic-corpus": "0.0.114",
    "@tscircuit/footprinter": "0.0.357",
    "@tscircuit/schematic-match-adapt": "0.0.18",
    "@tscircuit/schematic-viewer": "2.0.69",
    "@tscircuit/circuit-json-util": "0.0.96",
    "@tscircuit/miniflex": "0.0.4",
    "tscircuit": "0.0.1926",
    "circuit-json-to-bom-csv": "0.0.9",
    "circuit-json-to-gerber": "0.0.78",
    "circuit-json-to-kicad": "0.0.154",
    "circuit-json-to-pnp-csv": "0.0.8",
    "circuit-json-to-spice": "0.0.39",
    "circuit-to-svg": "0.0.358",
    "kicad-to-circuit-json": "0.0.97",
    "eecircuit-engine": "1.7.0",
    "avr8js": "0.21.0",
    "rp2040js": "1.3.3",
    "circuit-json": "0.0.438"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/express": "5.0.6",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@toolwind/corner-shape": "0.0.8-3",
    "tailwindcss": "^4.2.4",
    "shadcn": "^4.12.0",
    "typescript": "5.9.3",
    "vite": "^8.0.10",
    "tsx": "4.23.15",
    "concurrently": "10.0.6",
    "@types/js-yaml": "4.0.9",
    "prettier": "3.6.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "diff": "8.0.4",
    "pngjs": "7.0.0"
  }
}

