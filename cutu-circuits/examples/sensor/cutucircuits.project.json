  "hardware": {
    "version": 1,
    "name": "Editable local controller",
    "description": "Programs own the device protocol. Offline inspection and actual serial JSONL acquisition.",
    "capabilities": [
      {
        "id": "inspect",
        "label": "Inspect design",
        "description": "Reads saved project files; no hardware connection.",
        "kind": "read",
        "command": "python3",
        "args": [
          "programs/controller.py",
          "inspect"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "timeoutMs": 30000,
        "persistent": false
      },
      {
        "id": "serial",
        "label": "Read serial device",
        "description": "Reads actual JSON Lines from a local serial port; requires pyserial.",
        "kind": "read",
        "command": "python3",
        "args": [
          "programs/controller.py",
          "serial"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "port": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "default": "/dev/ttyUSB0"
            },
            "baud": {
              "type": "integer",
              "minimum": 300,
              "maximum": 2000000,
              "default": 115200
            },
            "durationSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "default": 30
            }
          },
          "required": [
            "port",
            "baud",
            "durationSeconds"
          ],
          "additionalProperties": false
        },
        "timeoutMs": 310000,
        "persistent": true
      }
    ]
  }
