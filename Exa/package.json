{
  "name": "@cutucircuits/exa",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded backend-only Exa search and contents client",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md", ".env.example"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": { "@types/node": "24.12.2", "typescript": "5.9.3" }
}
